# Firma de las sesiones. Genera una con: openssl rand -base64 48
SESSION_SECRET=

# Global Config: la añade Vercel al conectar el almacén al proyecto
EDGE_CONFIG=

# Para guardar cambios en Global Config desde el panel (Vercel > Settings > Tokens)
VERCEL_API_TOKEN=
# Solo si el proyecto está en un equipo (team), no en una cuenta personal
VERCEL_TEAM_ID=

# Blob: lo añade Vercel al conectar el almacén (autenticación OIDC).
# En local, descarga las variables con: vercel env pull .env.local
BLOB_STORE_ID=

# Opcional: contraseña del profesor como hash, si no se guarda en Global Config
# (se obtiene con: npx tsx scripts/create-admin.ts)
ADMIN_PASSWORD_HASH=

# Desarrollo y pruebas: usa archivos locales en lugar de Vercel
# STORE_BACKEND=local
# DATA_DIR=.data
